    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3",
    "vitest": "~2.1.4"
  }
}
